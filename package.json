{
  "name": "@joshblack/www",
  "type": "module",
  "private": true,
  "author": "Josh Black <josh@josh.black>",
  "license": "MIT",
  "scripts": {
    "build": "astro build",
    "clean": "rimraf .astro dist",
    "develop": "astro dev",
    "format": "prettier --write \"**/*.{astro,css,js,md,scss,ts}\"",
    "format:diff": "prettier --list-different \"**/*.{astro,css,js,md,scss,ts}\"",
    "format:staged": "prettier --write",
    "lint": "eslint . --max-warnings=0",
    "start": "astro dev",
    "type-check": "astro check",
    "prepare": "husky"
  },
  "dependencies": {
    "feed": "^5.1.0",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.0.1",
    "astro": "7.1.6",
    "eslint": "^9.29.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "lint-staged": {
    "*.{astro,ts,js,cjs,mjs}": [
      "pnpm format:staged",
      "eslint --fix"
    ],
    "*.{scss,css}": [
      "pnpm format:staged"
    ],
    "*.md": [
      "pnpm format:staged"
    ]
  },
  "packageManager": "pnpm@10.12.4+sha512.5ea8b0deed94ed68691c9bad4c955492705c5eeb8a87ef86bc62c74a26b037b08ff9570f108b2e4dbd1dd1a9186fea925e527f141c648e85af45631074680184"
}
