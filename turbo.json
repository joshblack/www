{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "build/**"]
    },
    "//#format:diff": {
      "outputs": []
    },
    "//#lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "//#type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },
    "//#clean": {
      "cache": false
    }
  }
}
